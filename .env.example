# BSB Payroll — copy to .env.local and fill in values.
# Never commit real secrets. Never expose the service role key to the client.

# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STAGING_APP_URL=
SESSION_SECRET=replace-with-a-long-random-string

# Set to true only for local/demo preview without a live Supabase project.
# Production must keep this false and use real Supabase credentials.
NEXT_PUBLIC_DEMO_MODE=false

# Internal auth email domain used as a username mapping layer.
# This address is never shown in the product UI.
AUTH_EMAIL_DOMAIN=auth.bsbpayroll.internal

# Optional SMTP. Email is never marked sent unless these are set and delivery succeeds.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_FROM=

# Shared secret for POST /api/internal/jobs. Leave empty to disable the worker endpoint.
JOBS_WORKER_SECRET=

# Optional analytics assistant. Leave empty to keep the assistant unconfigured.
# Core analytics and anomaly detection work without these values.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=
USER_LLM_MODEL=

# Optional Razorpay. Leave empty to keep checkout unconfigured.
# An unconfigured provider cannot mark invoices paid or activate subscriptions.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
